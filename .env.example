ASPNETCORE_ENVIRONMENT=Production
# VM / systemd + Nginx only. Do NOT set on Railway: it injects PORT and the app binds to it automatically.
# ASPNETCORE_URLS=http://127.0.0.1:5080
ConnectionStrings__DefaultConnection=Server=SQL_HOST,1433;Database=ORBIT;User Id=ORBIT_APP;Password=CHANGE_ME;Encrypt=True;TrustServerCertificate=False
Jwt__Key=GENERATE_AT_LEAST_32_RANDOM_CHARACTERS
Jwt__Issuer=ORBIT.API
Jwt__Audience=ORBIT.Client
Jwt__ExpireMinutes=60
RESEND_API_KEY=SET_IN_SERVER_SECRET_STORE
RESEND_FROM_ADDRESS="ORBIT <noreply@example.com>"
AquariumPhotos__RootPath=/var/lib/orbit-api/aquarium-photos
# Optional: extra browser origins allowed by CORS (localhost/127.0.0.1 are always allowed).
# Cors__AllowedOrigins__0=https://app.example.com
